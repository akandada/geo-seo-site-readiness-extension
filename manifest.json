{
  "manifest_version": 3,
  "name": "Site Readiness Auditor",
  "description": "Audits performance, crawlability, GEO content optimization, SEO, LLM-readiness, a11y, and infinite scroll best practices.",
  "version": "2.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Site Readiness Auditor"
  },
  "permissions": [
    "scripting",
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": { "service_worker": "service_worker.js" },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "report.html",
        "report.js",
        "report/*.js",
        "popup.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
